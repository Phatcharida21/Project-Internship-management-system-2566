internship ||..|| app_detail : "มีรายละเอียดทักษะ (1:1)"
internship ||..o{ doc : "1.5, 1.6 เอกสารแนบ"
internship ||..o{ log : "บันทึกงาน"
internship ||..o{ comment : "คอมเมนต์"
internship ||..o{ eval : "ผลประเมิน"

@enduml